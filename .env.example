RAMU_APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Public Cloudflare Turnstile site key. Store its secret in Supabase Auth settings.
TURNSTILE_SITE_KEY=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_PICKER_KEY=
GOOGLE_SHEETS_PROJECT_NUMBER=
GEMINI_API_KEY=
GEMINI_IMPORT_ENABLED=true
GEMINI_MODEL=gemini-3.1-flash-lite
# Set paid only after enabling Cloud Billing on the API key's project.
GEMINI_SERVICE_TIER=unpaid
# Local synthetic demo. Disable before any public deployment review.
GEMINI_DEMO_ENABLED=true
